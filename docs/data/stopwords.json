{
  "_note": "停用词表。中文功能词（的/是/在/怎么/什么 等）在几乎每条记录里都出现，会让 BM25 排序噪声变大，也会让「今天天气怎么样」这类库外问题虚高命中。索引与查询两端使用同一份表，逐 token 精确匹配过滤。注意：只收功能词，不动实词。「多少」「几个」这类带信息量的词刻意保留。",
  "stopwords": [
    "的", "了", "是", "在", "有", "和", "与", "及", "或", "把", "被", "得", "地", "着",
    "我", "你", "他", "她", "它", "们", "这", "那", "哪", "什", "么", "吗", "呢", "吧",
    "啊", "呀", "哦", "嗯", "就", "都", "也", "还", "很", "会", "能", "要", "可", "不",
    "一", "上", "下", "个", "请", "问", "想", "给", "对", "从", "到", "让", "用", "于",
    "之", "并", "而", "但", "又", "再", "只", "更", "最", "没", "无", "些", "位", "名",
    "好", "里", "如", "何", "才", "该", "由", "向", "同",
    "什么", "怎么", "么样", "这样", "那样", "一样", "一个", "一些", "可以", "是否",
    "我们", "你们", "他们", "这个", "那个", "哪个", "就是", "还是", "但是", "因为",
    "所以", "如果", "的话", "一下", "起来", "什么样", "怎么样", "如何", "咋办"
  ]
}
