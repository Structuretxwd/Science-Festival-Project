{
  "_note": "离线检索引擎参数。Java 引擎与 JS 引擎必须读取同一份文件，任何一方都不得硬编码。改这里会同时影响两个实现。",
  "bm25": {
    "k1": 1.2,
    "b": 0.75
  },
  "tokenWeights": {
    "bigram": 1.0,
    "unigram": 0.45
  },
  "fieldWeights": {
    "question": 3.0,
    "altQuestions": 2.0,
    "keywords": 2.5,
    "answer": 1.0
  },
  "confidence": {
    "_note": "coverage = 命中的不同查询词数 / 查询词总数；gapRatio = (top1分数 - top2分数) / top1分数",
    "highCoverage": 0.7,
    "midCoverage": 0.35,
    "highGapRatio": 0.12
  },
  "maxCandidates": 3,
  "messages": {
    "_note": "两个引擎共用同一套话术，避免文案跑偏",
    "lowFallback": "这个问题我还没学到，抱歉。\n我目前只掌握校园相关的信息，你可以换个说法，或者问得更具体一点。\n如果开启联网大模型模式，我也可以用通用知识试着回答你。",
    "midPrefix": "我理解得可能不准确，先给你这个答案：",
    "lowNotice": "离线知识库未命中",
    "midNotice": "离线知识库匹配度一般"
  },
  "llm": {
    "_note": "在线模式的大模型配置。Java 侧（Llm.java）与浏览器侧（llm-js.js）读同一份文件，两边行为必须等价。providers 按数组顺序作为自动匹配的候选顺序（defaultProvider 优先级最高）。",
    "defaultProvider": "deepseek",
    "providers": [
      {
        "id": "deepseek",
        "label": "DeepSeek",
        "baseUrl": "https://api.deepseek.com",
        "model": "deepseek-chat",
        "modelHints": ["deepseek-chat", "deepseek"]
      },
      {
        "id": "moonshot",
        "label": "Kimi",
        "baseUrl": "https://api.moonshot.cn/v1",
        "model": "moonshot-v1-8k",
        "modelHints": ["moonshot"]
      },
      {
        "id": "dashscope",
        "label": "通义千问",
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "model": "qwen-plus",
        "modelHints": ["qwen-plus", "qwen"]
      },
      {
        "id": "openai",
        "label": "OpenAI 兼容",
        "baseUrl": "https://api.openai.com/v1",
        "model": "gpt-4o-mini",
        "modelHints": ["gpt-4o-mini", "gpt-4o", "gpt"]
      },
      {
        "id": "custom",
        "label": "自定义",
        "baseUrl": "",
        "model": "",
        "modelHints": []
      }
    ],
    "probePath": "/models",
    "chatPath": "/chat/completions",
    "probeTimeoutMs": 2500,
    "chatTimeoutMs": 30000,
    "historyTurns": 6,
    "temperature": 0.3,
    "mode": {
      "_note": "onlineAsk=always：在线模式下所有问题都交给大模型（不再看置信度）；kbFallbackToModel=true：知识库未覆盖时允许大模型用通用常识作答",
      "onlineAsk": "always",
      "kbFallbackToModel": true
    }
  },
  "server": {
    "preferredPort": 8080
  }
}
